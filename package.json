{
  "name": "@livelayer/react",
  "version": "0.26.0",
  "description": "LiveLayer agent widget for React — avatar video, team switching, responsive layouts, full-fidelity embed",
  "keywords": [
    "livelayer",
    "ai-agent",
    "voice-agent",
    "avatar",
    "livekit",
    "react",
    "widget"
  ],
  "homepage": "https://livelayer.studio",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@livelayer/sdk": "^0.9.0",
    "html-to-image": "^1.11.13",
    "livekit-client": "^2.23.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fusion-Studios-Code/live-layer-react.git"
  },
  "bugs": {
    "url": "https://github.com/Fusion-Studios-Code/live-layer-react/issues"
  }
}
